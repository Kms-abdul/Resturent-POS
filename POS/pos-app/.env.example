# Copy this file to `.env` and edit. Never commit `.env`.

# Port the POS server listens on. Tills reach it at https://<server-ip>:<PORT>
# The server speaks HTTPS only, using a self-signed certificate it generates
# and renews itself in data/certs/ -- see README for the one-time "connection
# is not private" warning each device shows on first visit.
PORT=4000

# Bind address. 0.0.0.0 exposes the server to your shop wifi so other tills can
# connect. Use 127.0.0.1 if you are running a single till on this machine only.
HOST=0.0.0.0

# Secret used to sign login tokens. MUST be changed before real use.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_RUN_THE_COMMAND_ABOVE

# How long a till stays logged in before it must re-enter its PIN.
SESSION_TTL=12h

# Where the Excel workbook and journal live. Relative paths are resolved from the
# project root. Keep this on a local disk, NOT a network share or cloud-synced
# folder (Dropbox/OneDrive/Google Drive) -- sync clients rewrite files underneath
# you and will corrupt the workbook.
DATA_DIR=./data

# Excel workbook filename inside DATA_DIR.
WORKBOOK=pos-data.xlsx

# Milliseconds to wait after the last write before rewriting the workbook.
# Writes are always journalled immediately; this only debounces the .xlsx rewrite
# so a busy dinner rush doesn't rewrite the file on every single tap.
FLUSH_DEBOUNCE_MS=2000

# Maximum time between workbook rewrites even under continuous load.
FLUSH_MAX_WAIT_MS=15000

# How many timestamped backups to keep in DATA_DIR/backups.
BACKUP_KEEP=30

# Currency minor-unit label and symbol used on receipts.
CURRENCY_SYMBOL=₹

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
